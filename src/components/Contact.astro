---
const email = 'thiernoabdoulayesall@esp.sn';
const linkedin = 'https://www.linkedin.com/in/thierno-abdoulaye-sall-a6a9aa299';
const sujet = 'Prise de contact — via votre portfolio';

/* trois voies vers la même boîte, par ordre de fiabilité décroissante :
   1. mailto  → respecte le client par défaut, natif sur mobile
   2. Gmail   → secours si aucun client n'est configuré
   3. copie   → dernier recours, marche partout */
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(sujet)}`;
const gmailHref =
  'https://mail.google.com/mail/?view=cm&fs=1' +
  `&to=${encodeURIComponent(email)}` +
  `&su=${encodeURIComponent(sujet)}`;
---
<section id="contact" class="py-32 md:py-40 text-center relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] max-w-[700px] max-h-[700px] glow-radial blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto px-7 reveal">
    <h2 class="font-display font-bold text-[clamp(2.4rem,6vw,4rem)] tracking-tight leading-[1.05] mb-6">
      Construisons quelque chose<br /><span class="grad-text">de solide.</span>
    </h2>
    <p class="text-lilac-300/80 max-w-md mx-auto mb-10">
      Une opportunité, un stage ou une question sur les réseaux ? La ligne est ouverte.
    </p>

    <!-- une seule action franche : le client mail du visiteur -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a href={mailtoHref} class="btn-primary">✉ {email}</a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">LinkedIn ↗</a>
    </div>

    <!-- les secours, discrets : ils ne servent qu'à ceux que le mailto laisse en plan -->
    <p class="mt-7 font-mono text-[12px] text-lilac-300/55">
      Pas de client mail ?
      <a href={gmailHref} target="_blank" rel="noopener noreferrer" class="alt-link">Ouvrir dans Gmail</a>
      <span class="text-plum-700 mx-1.5">·</span>
      <button id="copy-mail" type="button" data-mail={email} class="alt-link">Copier l'adresse</button>
    </p>

    <p
      id="copy-feedback"
      role="status"
      aria-live="polite"
      class="font-mono text-[11px] text-peach-200 mt-4 h-4 opacity-0 transition-opacity duration-200"
    ></p>
  </div>
</section>

<style>
  .alt-link {
    color: rgba(246, 219, 192, .85);
    text-underline-offset: 4px;
    text-decoration: underline;
    text-decoration-color: rgba(246, 219, 192, .3);
    transition: color .2s, text-decoration-color .2s;
  }
  .alt-link:hover { color: #F8F4E9; text-decoration-color: rgba(248, 244, 233, .7); }
</style>

<script>
  const btn = document.getElementById('copy-mail') as HTMLButtonElement | null;
  const feedback = document.getElementById('copy-feedback');
  let timer: ReturnType<typeof setTimeout>;

  function say(msg: string) {
    if (!feedback) return;
    feedback.textContent = msg;
    feedback.style.opacity = '1';
    clearTimeout(timer);
    timer = setTimeout(() => { feedback.style.opacity = '0'; }, 2600);
  }

  // navigator.clipboard exige un contexte sécurisé (https ou localhost) :
  // en http on retombe sur la vieille méthode, sinon la copie échoue en silence
  async function copy(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(ta);
    if (!ok) throw new Error('copie refusée');
  }

  btn?.addEventListener('click', async () => {
    const mail = btn.getAttribute('data-mail') ?? '';
    try {
      await copy(mail);
      say('✓ Adresse copiée');
    } catch {
      say(mail);
    }
  });
</script>
