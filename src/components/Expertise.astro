---
/* niveau : 1 = socle / quotidien · 2 = solide · 3 = notions & exploration
   il pilote la taille de la bulle, donc la hiérarchie visuelle du nuage */
const domains = [
  {
    idx: '01', tag: 'RÉSEAUX', title: 'Réseaux & Télécoms', icon: 'network', accent: '246 200 154',
    desc: "Conception et simulation d'architectures : routage multi-protocoles, SD-WAN, VPN IPsec site-à-site et planification radio.",
    skills: [
      { name: 'OSPF', lvl: 1 }, { name: 'BGP', lvl: 1 }, { name: 'SD-WAN', lvl: 1 },
      { name: 'MPLS/VRF', lvl: 2 }, { name: 'IPsec/IKEv2', lvl: 2 }, { name: 'GNS3', lvl: 3 },
    ],
  },
  {
    idx: '02', tag: 'SÉCURITÉ', title: 'Cybersécurité', icon: 'shield', accent: '232 139 166',
    desc: "Supervision SOC, détection d'intrusion et durcissement — du pare-feu applicatif à la cartographie MITRE ATT&CK.",
    skills: [
      { name: 'Wazuh', lvl: 1 }, { name: 'MITRE ATT&CK', lvl: 1 },
      { name: 'FortiWeb', lvl: 2 }, { name: 'HIDS/FIM', lvl: 3 }, { name: 'CIS', lvl: 3 },
    ],
  },
  {
    idx: '03', tag: 'SYSTÈME', title: 'Administration Système', icon: 'server', accent: '183 155 232',
    desc: "Déploiement de SI complets sous Linux : identité SSO, services réseau, messagerie et reverse proxy sécurisé.",
    skills: [
      { name: 'Linux', lvl: 1 }, { name: 'Active Directory', lvl: 1 }, { name: 'Docker', lvl: 1 },
      { name: 'FreeIPA', lvl: 2 }, { name: 'Nginx', lvl: 2 },
    ],
  },
  {
    idx: '04', tag: 'DEV & DATA', title: 'Développement & Data', icon: 'code', accent: '127 209 196',
    desc: "Du script à l'application web, avec une ouverture Big Data et IoT pour exploiter la donnée en temps réel.",
    skills: [
      { name: 'Python', lvl: 1 }, { name: 'Java', lvl: 2 }, { name: 'JavaScript', lvl: 2 },
      { name: 'Hadoop', lvl: 3 }, { name: 'Spark', lvl: 3 }, { name: 'Node-RED', lvl: 3 },
    ],
  },
];

/* noms écrits en toutes lettres : Tailwind purge ce qu'il ne voit pas,
   une classe construite façon `bubble-${lvl}` disparaîtrait du build */
const sizeClass = { 1: 'bubble-1', 2: 'bubble-2', 3: 'bubble-3' };

const icons = {
  network: '<circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M7.6 7.6 10.6 16M16.4 7.6 13.4 16M8 6h8"/>',
  shield:  '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/>',
  server:  '<rect x="4" y="4" width="16" height="6" rx="1.5"/><rect x="4" y="14" width="16" height="6" rx="1.5"/><path d="M7.5 7h.01M7.5 17h.01"/>',
  code:    '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13 5l-2 14"/>',
};
---
<section id="expertise" class="py-28 md:py-32">
  <div class="max-w-6xl mx-auto px-7">

    <div class="reveal mb-16">
      <span class="eyebrow mb-5">Ce que je maîtrise</span>
      <h2 class="section-title mt-4">Quatre couches,<br class="hidden sm:block" /> une même rigueur.</h2>
    </div>

    <div class="flex flex-col">
      {domains.map((d, gi) => (
        <div
          class="dom-group reveal grid md:grid-cols-[14rem_1fr] gap-7 md:gap-12 py-11 border-t border-plum-800/70 first:border-t-0 first:pt-0"
          style={`--accent:${d.accent}; transition-delay:${gi * 110}ms`}
        >
          <!-- ░ étiquette du domaine ░ -->
          <div class="flex md:flex-col items-center md:items-start gap-4">
            <div
              class="dom-badge shrink-0 w-12 h-12 rounded-full flex items-center justify-center transition-all duration-300"
              style="color:rgb(var(--accent)); border:1px solid rgb(var(--accent)/.3); background:rgb(var(--accent)/.08)"
            >
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[d.icon]} />
            </div>
            <div>
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[11px] tracking-[0.14em]" style="color:rgb(var(--accent)/.75)">{d.tag}</span>
                <span class="font-mono text-[11px] text-plum-700">/ {d.idx}</span>
              </div>
              <h3 class="font-display font-semibold text-xl md:text-2xl mt-1 leading-tight">{d.title}</h3>
            </div>
          </div>

          <!-- ░ le nuage ░ -->
          <div>
            <p class="text-lilac-300/70 text-[0.93rem] leading-relaxed max-w-xl mb-7">{d.desc}</p>
            <div class="flex flex-wrap items-center gap-3.5">
              {d.skills.map((s, i) => (
                <span
                  class="bubble-float"
                  style={`animation-duration:${5 + ((gi + i) % 4) * 0.8}s; animation-delay:${(i * 0.34).toFixed(2)}s`}
                >
                  <span class={`bubble ${sizeClass[s.lvl]}`}>{s.name}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* survol du groupe : l'accent du domaine se réveille, badge compris */
  .dom-group:hover .dom-badge {
    border-color: rgb(var(--accent) / .7);
    background: rgb(var(--accent) / .16);
    box-shadow: 0 0 26px -6px rgb(var(--accent) / .5);
  }
</style>
