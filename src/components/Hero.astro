---
// icônes sociales
// external : un mailto: ne doit JAMAIS ouvrir d'onglet — le navigateur en
// laisserait un vide derrière lui avant de passer la main au client mail
const socials = [
  { label: 'GitHub', href: 'https://github.com/mutnick21', external: true, icon: 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/thierno-abdoulaye-sall-a6a9aa299', external: true, icon: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z' },
  { label: 'Email', href: 'mailto:thiernoabdoulayesall@esp.sn', external: false, icon: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z' },
];
---
<header id="accueil" class="relative md:min-h-screen flex items-center overflow-hidden pt-28 pb-20 md:py-0">
  <!-- les halos d'ambiance vivent désormais dans Layout (.bg-layers) -->

  <div class="relative z-10 max-w-6xl mx-auto px-7 w-full grid md:grid-cols-2 gap-14 md:gap-8 items-center">

    <!-- ░ GAUCHE : texte ░ -->
    <div class="order-2 md:order-1">
      <div class="inline-flex items-center gap-2 mb-7 px-3 py-1.5 rounded-full border border-plum-700 bg-plum-900/50 font-mono text-[11px] tracking-wide text-lilac-300">
        <span class="w-1.5 h-1.5 rounded-full bg-peach-200 shadow-[0_0_8px_#F6DBC0] animate-pulse"></span>
        Disponible pour un stage / une alternance
      </div>

      <p class="eyebrow mb-4">Salut, moi c'est Thierno</p>

      <h1 class="font-display font-bold leading-[1.02] tracking-tight text-[clamp(2.6rem,6.2vw,4.6rem)] mb-6">
        Ingénieur <span class="grad-text">Réseaux</span><br />&amp; Télécoms
      </h1>

      <p class="text-lilac-300/90 text-lg max-w-md mb-8 leading-relaxed">
        Élève ingénieur à l'<span class="text-cream-100 font-medium">ESP de Dakar</span>. Je conçois, sécurise
        et administre des infrastructures réseau performantes — du routage OSPF/BGP au SOC.
      </p>

      <!-- réseaux sociaux -->
      <div class="flex items-center gap-3 mb-9">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            aria-label={s.label}
            class="w-11 h-11 rounded-full border border-plum-700 flex items-center justify-center text-lilac-300 hover:text-plum-950 hover:bg-peach-200 hover:border-peach-200 transition-all duration-200"
          >
            <svg viewBox="0 0 24 24" class="w-4.5 h-4.5" width="18" height="18" fill="currentColor"><path d={s.icon} /></svg>
          </a>
        ))}
      </div>

      <div class="flex flex-wrap gap-4">
        <a href="/cv.pdf" download class="btn-primary">Télécharger mon CV ↓</a>
        <a href="/contact/" class="btn-ghost">Me contacter</a>
      </div>
    </div>

    <!-- ░ DROITE : portrait circulaire + halo ░ -->
    <div class="order-1 md:order-2 flex items-center justify-center">
      <div class="relative flex items-center justify-center animate-float">
        <!-- glow derrière -->
        <div class="absolute w-[130%] h-[130%] glow-radial blur-2xl"></div>
        <!-- anneaux -->
        <div class="absolute w-[118%] h-[118%] rounded-full border border-peach-200/15" style="animation: pulse-ring 5s ease-in-out infinite;"></div>
        <div class="absolute w-[132%] h-[132%] rounded-full border border-dashed border-peach-200/25 animate-spin-slow"></div>
        <!-- portrait -->
        <div class="relative w-[260px] h-[260px] sm:w-[320px] sm:h-[320px] md:w-[380px] md:h-[380px] rounded-full overflow-hidden ring-1 ring-peach-200/30 bg-plum-900">
          <img src="/portrait.png" alt="Thierno Abdoulaye Sall"
               class="w-full h-full object-cover object-top select-none" draggable="false" />
        </div>
        <!-- puces flottantes -->
        <span class="absolute -left-3 top-12 px-3 py-1.5 rounded-lg bg-plum-800/90 border border-plum-700 font-mono text-[11px] text-lilac-300 animate-float" style="animation-delay:.8s;">SD-WAN</span>
        <span class="absolute -right-2 bottom-16 px-3 py-1.5 rounded-lg bg-plum-800/90 border border-plum-700 font-mono text-[11px] text-lilac-300 animate-float" style="animation-delay:1.8s;">SOC Wazuh</span>
      </div>
    </div>
  </div>

  <a href="/expertise/" class="hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-lilac-300/60 hover:text-cream-100 transition-colors">
    Défiler <span>↓</span>
  </a>
</header>
