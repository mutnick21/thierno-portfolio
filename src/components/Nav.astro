---
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/expertise/', label: 'Expertise' },
  { href: '/projets/', label: 'Projets' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];
const norm = (p) => (p.endsWith('/') ? p : p + '/');
const current = norm(Astro.url.pathname);
const isActive = (href) => norm(href) === current;
---
<nav id="nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-7 py-5 flex items-center justify-between">
    <a href="/" class="font-mono text-sm font-medium flex items-center gap-2.5 tracking-tight">
      <span class="w-[7px] h-[7px] rounded-full bg-peach-200 shadow-[0_0_10px_#F6DBC0] animate-pulse"></span>
      Thierno Sall
    </a>

    <div class="hidden md:flex items-center gap-7 font-mono text-[11px] uppercase tracking-[0.15em]">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['transition-colors', isActive(l.href) ? 'text-peach-200' : 'text-lilac-300/70 hover:text-cream-100']}
        >{l.label}</a>
      ))}
    </div>

    <button id="burger" aria-label="Menu" class="md:hidden flex flex-col gap-[5px] p-1.5">
      <span class="w-5 h-[1.5px] bg-cream-100 transition-all"></span>
      <span class="w-5 h-[1.5px] bg-cream-100 transition-all"></span>
      <span class="w-5 h-[1.5px] bg-cream-100 transition-all"></span>
    </button>
  </div>
</nav>

<div
  id="menu"
  class="fixed inset-y-0 right-0 z-40 w-3/4 max-w-xs bg-plum-900 border-l border-plum-700 flex flex-col items-center justify-center gap-10 font-mono text-base translate-x-full transition-transform duration-300 md:hidden"
>
  {links.map((l) => (
    <a
      href={l.href}
      class:list={['transition-colors menu-link', isActive(l.href) ? 'text-peach-200' : 'text-lilac-300 hover:text-cream-100']}
    >{l.label}</a>
  ))}
</div>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => {
    const on = window.scrollY > 40;
    nav?.classList.toggle('bg-plum-950/85', on);
    nav?.classList.toggle('backdrop-blur-md', on);
    nav?.classList.toggle('border-b', on);
    nav?.classList.toggle('border-plum-800', on);
  };
  window.addEventListener('scroll', onScroll);
  onScroll();

  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');
  let open = false;
  const toggle = (v) => { open = v; menu?.classList.toggle('translate-x-full', !open); };
  burger?.addEventListener('click', () => toggle(!open));
  document.querySelectorAll('.menu-link').forEach((a) => a.addEventListener('click', () => toggle(false)));
</script>
